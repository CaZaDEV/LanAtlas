# Where to listen. Default 127.0.0.1 (this machine only). LanAtlas has NO login:
# expose it to the LAN only behind a reverse proxy with authentication (see README).
HOST=127.0.0.1
PORT=8080

# Database, secret key and uploaded map files. Back up the whole folder.
DATA_DIR=./data

# Key used to encrypt passwords and licence keys (min. 16 chars). If empty, one is
# generated in DATA_DIR/secret.key on first start. Never change it afterwards.
LANATLAS_SECRET_KEY=

# Host names accepted in the Host header (DNS-rebinding protection). Defaults to
# localhost,127.0.0.1 when HOST is local. Example behind a proxy: lanatlas.example.lan
ALLOWED_HOSTS=

# Time zone used to split daily uptime stats (default: system time zone).
APP_TIMEZONE=

# Name stored as "created/updated by".
OPERATOR_NAME=Admin

# 0 = disable periodic checks (manual "Test now" still works).
MONITOR_ENABLED=1
